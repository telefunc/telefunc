{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "ESNext"],
    "types": [
      "@cloudflare/workers-types",
      "./worker-configuration.d.ts",
      "vite/client"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "**/*",
    // Include .test* files
    // https://github.com/microsoft/TypeScript/issues/49555
    "**/.*"
  ]
}
