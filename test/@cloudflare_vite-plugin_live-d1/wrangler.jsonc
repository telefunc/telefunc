{
  // spellcheck-ignore
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telefunc_test_cloudflare_vite-plugin_live-d1",
  "main": "./worker.ts",
  "compatibility_date": "2025-08-15",
  "durable_objects": {
    "bindings": [
      { "name": "TelefuncDurableObject", "class_name": "TelefuncDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TelefuncDurableObject"] }
  ],
  // Two bindings to one database: their live databases see each other's writes only through Broadcast, as two
  // isolates writing to one D1 database do.
  "d1_databases": [
    {
      "binding": "READER_DB",
      "database_name": "todos",
      "database_id": "live-d1"
    },
    {
      "binding": "WRITER_DB",
      "database_name": "todos",
      "database_id": "live-d1"
    }
  ]
}
