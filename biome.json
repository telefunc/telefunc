{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [
      "package.json",
      "dist/",
      "build/",
      ".svelte-kit/",
      ".next/",
      ".wrangler/"
    ]
  },
  "formatter": {
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "lineWidth": 120,
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "style": {
        "useNodejsImportProtocol": "error"
      }
    }
  },
  "organizeImports": {
    "enabled": false
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  },
  "overrides": [
    {
      "include": ["tsconfig.json", "tsconfig.*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ],
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
