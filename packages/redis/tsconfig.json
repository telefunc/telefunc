{
  "compilerOptions": {
    "outDir": "./dist/",
    "target": "ES2019",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "declaration": true,
    "strict": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["DOM", "ESNext"]
  },
  "include": ["src/**/*.ts"],
  "// src/room": "Production Room modules emit with this package; specs stay test-only.",
  "exclude": ["src/**/*.spec.ts"]
}
